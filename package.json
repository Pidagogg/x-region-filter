{
  "name": "x-region-filter",
  "private": true,
  "version": "0.1.0",
  "description": "Hide posts on X from accounts based in the regions you choose.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "zip": "tsc --noEmit && node build.mjs --zip",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3"
  }
}
